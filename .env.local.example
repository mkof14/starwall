ANTHROPIC_API_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local Postgres (same value for both). Production: Neon pooled URL + direct URL.
# Pooled → DATABASE_URL. Direct (migrations) → DIRECT_URL. Add ?sslmode=require if missing.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/starwall?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/starwall?sslmode=require
