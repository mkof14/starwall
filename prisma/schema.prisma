generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id
  email         String     @unique
  name          String
  organization  String     @default("")
  passwordHash  String     @default("")
  role          String     @default("Operator")
  pending       Boolean    @default(false)
  lastSignInAt  DateTime?
  createdAt     DateTime   @default(now())
  sessions      Session[]
  auditLogs     AuditLog[]
}

model Session {
  id              String           @id
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vesselName      String
  startedAt       DateTime         @default(now())
  events          Event[]
  conversations   Conversation[]
  blackBoxRecords BlackBoxRecord[]

  @@index([userId])
}

model Event {
  id         String   @id
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  timestamp  DateTime
  scenarioId String?
  category   String?
  riskLevel  String
  logText    String
  actionText String?

  @@index([sessionId, timestamp])
}

model Conversation {
  id        String   @id
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  timestamp DateTime
  role      String
  content   String
  langCode  String?

  @@index([sessionId, timestamp])
}

model BlackBoxRecord {
  id              String   @id
  sessionId       String
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type            String
  timestamp       DateTime
  summary         String
  fullContent     String   @default("")
  storageLocation String

  @@index([sessionId, timestamp])
}

model Equipment {
  id          String    @id
  name        String
  category    String
  lastCheckAt DateTime?
  status      String    @default("ok")
  addedAt     DateTime  @default(now())
}

model NotificationRoute {
  id        String  @id
  riskLevel String
  method    String
  contact   String  @default("")
  enabled   Boolean @default(true)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String
  timestamp DateTime @default(now())

  @@index([timestamp])
}

model Integration {
  id         String    @id
  name       String
  vendor     String
  lastPingAt DateTime?
}
