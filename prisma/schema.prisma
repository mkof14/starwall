generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String    @id
  email    String    @unique
  name     String
  sessions Session[]
}

model Session {
  id              String           @id
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vesselName      String
  startedAt       DateTime         @default(now())
  events          Event[]
  conversations   Conversation[]
  blackBoxRecords BlackBoxRecord[]

  @@index([userId])
}

model Event {
  id         String   @id
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  timestamp  DateTime
  scenarioId String?
  category   String?
  riskLevel  String
  logText    String
  actionText String?

  @@index([sessionId, timestamp])
}

model Conversation {
  id        String   @id
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  timestamp DateTime
  role      String
  content   String
  langCode  String?

  @@index([sessionId, timestamp])
}

model BlackBoxRecord {
  id              String   @id
  sessionId       String
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type            String
  timestamp       DateTime
  summary         String
  fullContent     String   @default("")
  storageLocation String

  @@index([sessionId, timestamp])
}
