{
  "name": "starwall",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "node scripts/prisma-generate.mjs && node scripts/migrate-if-hosted.mjs && next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "ensure": "bash scripts/ensure-site.sh",
    "up": "bash scripts/keep-site-up.sh",
    "test": "vitest run",
    "lint": "next lint && npm run lint:copy",
    "lint:copy": "node scripts/check-banned-terms.mjs",
    "capture:scenario": "node scripts/capture-scenario.js",
    "postinstall": "node scripts/prisma-generate.mjs",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@prisma/client": "^6.19.3",
    "framer-motion": "^13.2.0",
    "idb": "^8.0.3",
    "next": "^14.2.35",
    "next-auth": "^4.24.11",
    "react": "^18",
    "react-dom": "^18",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "^14.2.35",
    "playwright": "^1.63.0",
    "postcss": "^8",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
